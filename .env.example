# UFS Core Docker 环境变量
# 复制为 .env 后按需修改

# MySQL
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=ufs
MYSQL_USER=ufs
MYSQL_PASSWORD=ufs_pass

# Redis
# REDIS_PASSWORD=           # 留空 = 无密码

# App
APP_PORT=8080
UFS_VERSION=latest
UFS_JWT_SECRET=prod-jwt-secret-change-me-32bytes-min

# 云存储（可选，留空使用本地存储）
# UFS_COS_SECRET_ID=
# UFS_COS_SECRET_KEY=
# UFS_COS_REGION=ap-guangzhou
# UFS_COS_DEFAULT_BUCKET=
