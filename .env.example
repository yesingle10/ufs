# =============================================================================
# UFS Core 环境变量模板
# 复制为 .env 后编辑（.env 已在 .gitignore 中）
#
# 启动方式:
#   dev:      docker compose up -d
#   staging:  docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d
#   prod:     docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# =============================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ufs
MYSQL_USER=ufs
MYSQL_PASSWORD=change-me-user

# ---- Redis ----
# REDIS_PASSWORD=              # 留空 = 无密码

# ---- App ----
APP_PORT=8080
UFS_VERSION=latest
UFS_JWT_SECRET=change-me-min-32-bytes-long-secret-key

# ---- 云存储（dev/staging 可留空用本地存储） ----
# UFS_COS_SECRET_ID=
# UFS_COS_SECRET_KEY=
# UFS_COS_REGION=ap-guangzhou
# UFS_COS_DEFAULT_BUCKET=
# UFS_OSS_ACCESS_KEY_ID=
# UFS_OSS_ACCESS_KEY_SECRET=
# UFS_OSS_ENDPOINT=
# UFS_OSS_DEFAULT_BUCKET=
# UFS_KODO_ACCESS_KEY=
# UFS_KODO_SECRET_KEY=
# UFS_KODO_DEFAULT_BUCKET=
# UFS_TOS_ACCESS_KEY_ID=
# UFS_TOS_ACCESS_KEY_SECRET=
# UFS_TOS_ENDPOINT=
# UFS_TOS_REGION=
# UFS_TOS_DEFAULT_BUCKET=
