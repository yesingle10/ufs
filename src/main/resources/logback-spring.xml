<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 异步控制台日志，MDC 携带 requestId/tenantId（对齐 Java 规范 §9 / 监控规范 §3） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [rid=%X{requestId}] [tid=%X{tenantId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 框架日志降噪 -->
    <logger name="org.apache.rocketmq" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
</configuration>
